# =============================================================================
# Frontend / Next.js Configuration
# =============================================================================

# URL of the backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# =============================================================================
# LLM Configuration
# =============================================================================

# OpenAI-compatible API endpoint (e.g., Ollama, vLLM, OpenAI)
# Default Ollama endpoint: http://localhost:1234/v1
LLM_API_URL=http://localhost:1234/v1

# API key for the LLM provider (leave empty for local Ollama)
LLM_API_KEY=

# Model name for code generation (must match a model served by your LLM endpoint)
LLM_MODEL=qwen2.5-coder-32b-instruct

# =============================================================================
# CadGen Output & Sandbox Configuration
# =============================================================================

# Directory where generated CAD files (STEP, STL, GLTF) are stored
CADGEN_OUTPUT_DIR=/tmp/cadgen_outputs

# Remote sandbox URL for distributed execution (optional)
# Leave empty to use the local sandbox service
CADGEN_SANDBOX_URL=

# =============================================================================
# CORS Configuration
# =============================================================================

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# =============================================================================
# Database Configuration (optional)
# =============================================================================

# PostgreSQL connection string for production session persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/cadgen
